# ---- مطلوب ----
# محلي بلا إنترنت:  mongodb://127.0.0.1:27017/poplar
MONGO_URI=mongodb://127.0.0.1:27017/poplar
# سر الجلسات (إلزامي في الإنتاج، 32 حرفاً فأكثر). ولّده بـ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# ---- اختياري ----
PORT=5000
NODE_ENV=development
# أصول مسموح لها بالاتصال من متصفح آخر (فارغ = نفس الأصل فقط)
CORS_ORIGINS=
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=600
# true = بلا Transactions (تراجع تعويضي) حتى لو كانت القاعدة Replica Set
DISABLE_TRANSACTIONS=false
# مدة خمول الجلسة بالدقائق (480 = 8 ساعات) والحد الأقصى المطلق بالأيام
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=7
# كوكي Secure افتراضياً في الإنتاج. اضبطه false فقط لتجربة الإنتاج عبر http محلي
COOKIE_SECURE=
# محاولات الدخول الفاشلة لكل (IP + حساب) خلال 15 دقيقة
LOGIN_MAX_ATTEMPTS=8
# إنشاء أول مالك: npm run create-admin  (ADMIN_USERNAME / ADMIN_NAME / ADMIN_PASSWORD اختيارية، وإلا يُسأل تفاعلياً)
