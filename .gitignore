# Dependencies
node_modules/

# Environment and secrets (copy backend/.env.example to backend/.env locally)
.env
.env.*
!.env.example

# Local MongoDB data folder and server/dev logs
mongo-data/
*.log
logs/

# Database backups hold real data (users, sessions, financial records): never commit them.
# The folder itself is kept (with .gitkeep) because backup-db and the migrations write into it.
backend/backups/*
!backend/backups/.gitkeep

# Build output and test artefacts
frontend/dist/
dist/
coverage/
.nyc_output/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local AI-assistant tooling
.claude/
